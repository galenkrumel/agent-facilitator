# Cloudflare credentials. These are the only two values a fresh developer
# needs to set before `npm run setup`.
#
# Account ID: Cloudflare dashboard → Workers & Pages → Account details.
CLOUDFLARE_ACCOUNT_ID=

# API token: Cloudflare dashboard → My Profile → API Tokens → Create Token.
# See README ("Cloudflare API token permissions") for the required scopes.
CLOUDFLARE_API_TOKEN=
