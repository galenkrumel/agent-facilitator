# Cloudflare credentials. Set these, and SEED_TOKEN below, before
# `npm run setup`.
#
# Account ID: Cloudflare dashboard → Workers & Pages → Account details.
CLOUDFLARE_ACCOUNT_ID=

# API token: Cloudflare dashboard → My Profile → API Tokens → Create Token.
# See README ("Cloudflare API token permissions") for the required scopes.
CLOUDFLARE_API_TOKEN=

# Operator token for POST /admin/decisions — the only way a decision is
# created, and the only secret this Worker has. Generate your own:
#
#   openssl rand -hex 32
#
# `npm run setup` uploads it to the Worker with the deploy and uses it to seed.
# Never give it to a participant: a participant link is all anyone needs.
SEED_TOKEN=
